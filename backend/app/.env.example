# Configuration BlueRock - Exemple pour .env
# Copiez ce fichier vers .env et adaptez les valeurs

# SÉCURITÉ : Générez une clé secrète UNIQUE de 32 octets (64 caractères hex)
# Exemple: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generer_une_clé_hex64_aleatoire_et_unique

# Base de données
DATABASE_URL=postgresql://bluerock:bluerock123@localhost:5432/bluerock

# Supabase (Auth JWT, Storage, Admin API)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_KEY=votre_service_role_key

# Didit - Vérification identité (KYC)
DIDIT_API_KEY=votre_didit_api_key
DIDIT_WEBHOOK_SECRET=votre_webhook_secret
DIDIT_API_URL=https://verification.didit.me
DIDIT_FRAME_ORIGIN=https://verify.didit.me
DIDIT_CALLBACK_URL=http://localhost:3000/kyc?didit=return

# Stripe (via Supabase Edge Functions)
# Les clés Stripe vivent UNIQUEMENT côté Edge Functions (supabase/functions) :
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
# URL du webhook à enregistrer chez Stripe : <project_ref>.functions.supabase.co/stripe-webhook
STRIPE_RETURN_URL=http://localhost:3000/paiement?pay=return
SUPABASE_FUNCTIONS_URL=https://votre-projet.supabase.co/functions/v1
DEPOSIT_MIN_AMOUNT=100
DEPOSIT_MAX_AMOUNT=950000

# SMTP (emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=votre_email@example.com
SMTP_PASS=votre_mot_de_passe
SMTP_FROM=BlueRock <noreply@bluerock.ai>
SMTP_STARTTLS=true

# Admin
ADMIN_TOKEN=generer_un_token_admin_long_et_aleatoire

# Redis partagé (multi-instance : rate limit, OTP, échecs PIN, locks de jobs)
# Vide = store en mémoire par processus (mono-instance).
# Exemple Upstash Free : rediss://default:<token>@<region>.upstash.io:<port>
REDIS_URL=

# Frontend / API
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
BRVM_BASE_URL=https://www.brvm.org

# IA (optionnel)
OPENAI_API_KEY=votre_openai_key
GEMINI_API_KEY=votre_gemini_key

# Autres clés API tiers optionnelles